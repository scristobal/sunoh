{
  "$schema": "../node_modules/wrangler/config-schema.json",

  "name": "tiles",
  "main": "src/serve.ts",

  "compatibility_date": "2026-09-10",
  "workers_dev": true,

  "version_metadata": {
    "binding": "VERSION"
  },

  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "maps"
    }
  ]
}
