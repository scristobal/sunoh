set shell := ["bash", "-eu", "-o", "pipefail", "-c"]
set positional-arguments
# Just 1.47+ keeps help and credential setup independent of simulator discovery.
set lazy

PROJECT := "Sunoh.xcodeproj"
SCHEME := "Sunoh"
BUNDLE_ID := "com.samuel.sunoh"
DERIVED := justfile_directory() / ".build"
APP := DERIVED / "Build/Products/Debug-iphonesimulator/Sunoh.app"
SLOPES_EXPORT := env("SLOPES_EXPORT", justfile_directory() / ".local/sources/slopes-2025-2026")
SEED_ROOT := justfile_directory() / ".local/seed/slopes-2025-2026"
PHONE_UDID := `printenv PHONE_UDID || xcrun simctl list devices available -j | python3 scripts/simulator.py`

# List development commands without starting an operation.
[default]
[private]
default:
    @just --list

[private]
phone:
    @test -n {{ quote(PHONE_UDID) }} || (echo "Boot an iPhone simulator first."; exit 1)

# Build for the booted iPhone simulator, or the selected PHONE_UDID.
build: phone
    xcodebuild -project {{ quote(PROJECT) }} -scheme {{ quote(SCHEME) }} -destination {{ quote("id=" + PHONE_UDID) }} -derivedDataPath {{ quote(DERIVED) }} build

# Build, install and launch the app, then open the simulator viewer.
run: build
    xcrun simctl terminate {{ quote(PHONE_UDID) }} {{ quote(BUNDLE_ID) }} 2>/dev/null || true
    xcrun simctl install {{ quote(PHONE_UDID) }} {{ quote(APP) }}
    xcrun simctl launch {{ quote(PHONE_UDID) }} {{ quote(BUNDLE_ID) }}
    python3 scripts/simulator.py --open

# Run the retained track and geometry computation tests.
test *args: phone
    xcodebuild -project {{ quote(PROJECT) }} -scheme {{ quote(SCHEME) }} -destination {{ quote("id=" + PHONE_UDID) }} -derivedDataPath {{ quote(DERIVED) }} -parallel-testing-enabled NO "$@" test

# Replay DebugRoute.gpx on the selected simulator.
gps: phone
    python3 scripts/gps.py DebugRoute.gpx | xcrun simctl location {{ quote(PHONE_UDID) }} start --speed=5 -

# Create offline ski-feature packages in ignored local storage or an external directory.
ski-data source output:
    python3 scripts/ski_data.py "$1" "$2" --zip

# Prompt for a public Mapbox token and save the ignored app build configuration.
token:
    @python3 scripts/credentials.py

# Regenerate and validate the 2025/2026 seed from the original Slopes exports.
prepare-seed:
    python3 scripts/slopes_to_gpx.py --source {{ quote(SLOPES_EXPORT) }} --output {{ quote(SEED_ROOT) }}
    python3 scripts/seed.py --check --manifest {{ quote(SEED_ROOT / "manifest.json") }} {{ quote(SEED_ROOT / "gpx") }}

# Build and import the 2025/2026 Slopes season into the selected simulator.
seed: prepare-seed build
    xcrun simctl terminate {{ quote(PHONE_UDID) }} {{ quote(BUNDLE_ID) }} 2>/dev/null || true
    xcrun simctl install {{ quote(PHONE_UDID) }} {{ quote(APP) }}
    python3 scripts/seed.py --manifest {{ quote(SEED_ROOT / "manifest.json") }} {{ quote(PHONE_UDID) }} {{ quote(BUNDLE_ID) }} {{ quote(SEED_ROOT / "gpx") }}
    python3 scripts/simulator.py --open

# Build, install and seed a physical iPhone selected explicitly by device identifier.
seed-device device: prepare-seed
    xcodebuild -project {{ quote(PROJECT) }} -scheme {{ quote(SCHEME) }} -destination {{ quote("id=" + device) }} -derivedDataPath {{ quote(DERIVED) }} -allowProvisioningUpdates build
    xcrun devicectl device install app --device {{ quote(device) }} {{ quote(DERIVED / "Build/Products/Debug-iphoneos/Sunoh.app") }}
    python3 scripts/seed.py --physical --manifest {{ quote(SEED_ROOT / "manifest.json") }} {{ quote(device) }} {{ quote(BUNDLE_ID) }} {{ quote(SEED_ROOT / "gpx") }}

# Wipe the selected simulator installation and recreate the current V0 store.
clean: build
    xcrun simctl terminate {{ quote(PHONE_UDID) }} {{ quote(BUNDLE_ID) }} 2>/dev/null || true
    xcrun simctl uninstall {{ quote(PHONE_UDID) }} {{ quote(BUNDLE_ID) }}
    xcrun simctl install {{ quote(PHONE_UDID) }} {{ quote(APP) }}
    xcrun simctl launch {{ quote(PHONE_UDID) }} {{ quote(BUNDLE_ID) }}
    python3 scripts/simulator.py --open
