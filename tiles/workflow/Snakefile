"""Sunō generation workflow. Just selects targets; Snakemake owns dependencies."""

from pathlib import Path
import json
import os
import shutil
import sys

ROOT = Path(workflow.basedir).parent
sys.path.insert(0, str(ROOT / "scripts"))
import workflow_tasks as tasks
import terrain_processing as terrain
from check import validate
from map_style import COMPONENTS

DATA = Path(config["DATA_ROOT"])
D = str(DATA / "downloads")
G = str(DATA / "geometry")
T = str(DATA / "tiles")
R = str(DATA / "resources")
S = str(DATA / "scratch/snakemake")
os.environ["DATA_ROOT"] = str(DATA)

NE = tasks.NATURAL_EARTH
NE_FILES = [f"{D}/natural-earth/{entry[0]}.zip" for entry in NE.values()]
COAST = f"{D}/coastlines/water-polygons-split-4326.zip"
FONTS = config["FONT_TTFS"]
SPRITES = [f"{R}/sprite{suffix}" for suffix in (".png", ".json", "@2x.png", "@2x.json")]
TARGET = config.get("TARGET", "build")
KINDS = [TARGET.removeprefix("terrain-")] if TARGET in ("terrain-contours", "terrain-hillshade") else ["contours", "hillshade"]
MODE = KINDS[0] if len(KINDS) == 1 else "both"
SETTINGS = tasks.terrain_settings(config)


def inventory_path():
    return str(checkpoints.dem_inventory.get().output[0])


def dem_inputs(wildcards):
    names = list(tasks.dem_records(inventory_path()))
    if config["TERRAIN_DOWNLOAD_LIMIT"]:
        names = names[:config["TERRAIN_DOWNLOAD_LIMIT"]]
    return [f"{D}/dem/{name}.tif" for name in names]


def plan_path():
    return Path(checkpoints.terrain_plan.get().output[0])


def core_names():
    return terrain.read(plan_path() / "coverage.json")["ready"]


def batch_spec(wildcards):
    return str(plan_path() / f"{wildcards.batch}.json")


def batch_dems(wildcards):
    return terrain.read(batch_spec(wildcards))["neighbors"]


def geometry_inputs(wildcards):
    return [f"{G}/terrain/batches/{name}/{wildcards.kind}.geojsonl.gz" for name in core_names()]


def all_geometry(wildcards):
    return [f"{G}/terrain/batches/{name}/{kind}.geojsonl.gz" for name in core_names() for kind in KINDS]

rule build:
    input:
        S + "/outputs-validated.json"

rule maps:
    input:
        expand(T + "/{name}.pmtiles", name=["basemap", "ski", "contours", "hillshade"])

rule osm:
    input:
        expand(T + "/{name}.pmtiles", name=["basemap", "ski"])

rule resources:
    input:
        SPRITES + FONTS + [R + "/style.json"]

rule fonts:
    input:
        FONTS

rule terrain_geometry:
    input:
        all_geometry

rule terrain_tiles:
    input:
        expand(T + "/{kind}.pmtiles", kind=KINDS)

rule download_all:
    input:
        config["OSM_PBF"], NE_FILES, COAST, FONTS, dem_inputs

rule download_dem:
    input:
        dem_inputs

rule download_osm:
    input:
        config["OSM_PBF"]

rule download_natural_earth:
    input:
        NE_FILES

rule download_coastlines:
    input:
        COAST

rule download_fonts:
    input:
        FONTS

checkpoint dem_inventory:
    output:
        D + "/dem/inventory.json"
    params:
        bucket=tasks.BUCKET, recipe=tasks.recipe(tasks.inventory)
    run:
        tasks.inventory(output[0])

rule dem:
    input:
        lambda wildcards: inventory_path()
    output:
        D + "/dem/{batch}.tif"
    params:
        recipe=tasks.recipe(tasks.download_dem)
    resources:
        downloads=1
    run:
        tasks.download_dem(input[0], wildcards.batch, output[0])

rule osm_download:
    output:
        config["OSM_PBF"]
    params:
        url=config["OSM_URL"], recipe=tasks.recipe(tasks.download)
    run:
        tasks.download(params.url, output[0], snapshot=True)

rule natural_earth_download:
    output:
        D + "/natural-earth/{name}.zip"
    params:
        family=lambda wildcards: next(family for name, family in NE.values() if name == wildcards.name),
        recipe=tasks.recipe(tasks.download)
    run:
        tasks.download(f"https://naturalearth.s3.amazonaws.com/{params.family}/{wildcards.name}.zip", output[0])

rule coastline_download:
    output:
        COAST
    params:
        url=tasks.COASTLINE_URL, recipe=tasks.recipe(tasks.download)
    run:
        tasks.download(params.url, output[0])

# Individual font rules also allow explicitly configured font output paths.
for index, font_path in enumerate(FONTS):
    rule:
        name: f"font_{index}"
        output: font_path
        params:
            url=config["NOTO_SANS_URL"] + "/" + Path(font_path).name,
            recipe=tasks.recipe(tasks.download)
        run:
            tasks.download(params.url, output[0], retries=0)

checkpoint terrain_plan:
    input:
        lambda wildcards: inventory_path()
    output:
        directory(S + "/terrain-plan")
    params:
        bbox=config["TERRAIN_BBOX"], limit=config["TERRAIN_BATCH_LIMIT"], kinds=KINDS,
        recipe=tasks.recipe(tasks.plan_terrain)
    run:
        tasks.plan_terrain(input[0], output[0], config, KINDS)

rule terrain_settings:
    output:
        expand(G + "/terrain/settings/{kind}.json", kind=KINDS)
    params:
        settings={kind: SETTINGS[kind] for kind in KINDS}
    run:
        for kind in KINDS:
            terrain.save(Path(G) / "terrain/settings" / f"{kind}.json", params.settings[kind])

rule terrain_batch:
    input:
        spec=batch_spec,
        dems=batch_dems,
        settings=rules.terrain_settings.output,
        processing=str(ROOT / "scripts/terrain_processing.py"),
        hillshade=str(ROOT / "scripts/hillshade_original.py")
    output:
        geometry=expand(G + "/terrain/batches/{{batch}}/{kind}.geojsonl.gz", kind=KINDS),
        metadata=expand(G + "/terrain/batches/{{batch}}/{kind}.meta.json", kind=KINDS),
        receipt=G + "/terrain/batches/{batch}/done-" + MODE + ".json"
    params:
        recipe=tasks.recipe(tasks.process_batch)
    resources:
        terrain_jobs=1, mem_mb=4096
    run:
        tasks.process_batch(input.spec, output.receipt)

rule terrain_archive:
    input:
        geometry=geometry_inputs,
        metadata=lambda wildcards: [str(Path(path).with_name(wildcards.kind + ".meta.json")) for path in geometry_inputs(wildcards)],
        coverage=lambda wildcards: str(plan_path() / "coverage.json"),
        processing=str(ROOT / "scripts/terrain_tiling.py")
    output:
        archive=T + "/{kind}.pmtiles",
        summary=T + "/{kind}.build.json"
    wildcard_constraints:
        kind="contours|hillshade"
    params:
        maxzoom=config["TERRAIN_TILE_MAXZOOM"], simplification=config["TERRAIN_TILE_SIMPLIFICATION"],
        recipe=tasks.recipe(tasks.tile_terrain)
    threads:
        config["TERRAIN_TILE_THREADS"]
    resources:
        mem_mb=4096
    run:
        tasks.tile_terrain(input.geometry, input.coverage, wildcards.kind, config, threads)

rule planetiler_image:
    input:
        str(ROOT / "planetiler/Dockerfile"), str(ROOT / "planetiler/Sunoh.java")
    output:
        S + "/planetiler-image.json"
    params:
        image=config["PLANETILER_IMAGE"]
    run:
        tasks.run("docker", "build", "-t", params.image, ROOT / "planetiler")
        Path(output[0]).write_text(json.dumps({"image": params.image}) + "\n")

rule osm_archive:
    input:
        osm=config["OSM_PBF"], image=rules.planetiler_image.output
    output:
        T + "/{name}.pmtiles"
    wildcard_constraints:
        name="basemap|ski"
    params:
        heap=config["PLANETILER_HEAP"], docker=config["PLANETILER_DOCKER_ARGS"],
        args=config["PLANETILER_ARGS"], minzoom=config["BASEMAP_MINZOOM"], maxzoom=config["BASEMAP_MAXZOOM"],
        recipe=tasks.recipe(tasks.planetiler, tasks.verify_archive)
    threads:
        config["CORES"]
    resources:
        mem_mb=config["MEM_MB"]
    run:
        tasks.planetiler(wildcards.name, output[0], config)

rule overview_geometry:
    input:
        lambda wildcards: f"{D}/natural-earth/{NE[wildcards.layer][0]}.zip"
    output:
        G + "/overview/{layer}.geojsonl"
    wildcard_constraints:
        layer="ocean|borders|countries|admin1-borders|admin1-labels"
    params:
        recipe=tasks.recipe(tasks.convert_overview)
    run:
        tasks.convert_overview(wildcards.layer, input[0], output[0])

rule overview:
    input:
        expand(G + "/overview/{layer}.geojsonl", layer=list(NE))
    output:
        T + "/overview.pmtiles"
    params:
        recipe=tasks.recipe(tasks.verify_archive)
    threads:
        config["CORES"]
    resources:
        mem_mb=4096
    run:
        scratch = DATA / "scratch/overview"
        scratch.mkdir(parents=True, exist_ok=True)
        layers = []
        for name in NE:
            layers.extend(["-L", f"{name.replace('-', '_')}:{G}/overview/{name}.geojsonl"])
        tasks.run("tippecanoe", "--force", "-o", output[0], "--name=overview",
                  "--attribution=Made with Natural Earth (public domain)",
                  "--minimum-zoom=0", "--maximum-zoom=6", "--no-tile-size-limit",
                  f"--temporary-directory={scratch}", *layers)
        tasks.verify_archive(output[0])

rule coastline_geometry:
    input:
        COAST
    output:
        G + "/coastlines/ocean.geojsonl"
    run:
        tasks.run("ogr2ogr", "-overwrite", "-f", "GeoJSONSeq", output[0],
                  f"/vsizip/{input[0]}/water-polygons-split-4326/water_polygons.shp", "-t_srs", "EPSG:4326")

rule coastlines:
    input:
        rules.coastline_geometry.output
    output:
        T + "/coastlines.pmtiles"
    params:
        recipe=tasks.recipe(tasks.verify_archive)
    threads:
        config["CORES"]
    resources:
        mem_mb=4096
    run:
        scratch = DATA / "scratch/coastlines/tiling"
        scratch.mkdir(parents=True, exist_ok=True)
        part = Path(T) / "coastlines.part.pmtiles"
        tasks.run("tippecanoe", "--force", "-o", part, "--name=coastlines", "--layer=ocean",
                  "--attribution=© OpenStreetMap contributors; water polygons from osmdata.openstreetmap.de",
                  "--minimum-zoom=7", "--maximum-zoom=10", "--full-detail=14", "--low-detail=12",
                  "--no-tile-size-limit", "--no-feature-limit", f"--temporary-directory={scratch}", input[0])
        tasks.verify_archive(part)
        part.replace(output[0])

rule sprites:
    input:
        [str(path) for path in sorted((ROOT / "sprites").glob("*.png"))] + [str(ROOT / "scripts/sprites.sh")]
    output:
        SPRITES
    run:
        tasks.run("bash", ROOT / "scripts/sprites.sh")

rule style:
    input:
        str(ROOT / "styles/default.json")
    output:
        R + "/style.json"
    run:
        shutil.copyfile(input[0], output[0])

rule validate_outputs:
    input:
        rules.maps.input, rules.resources.input, str(ROOT / "scripts/check.py")
    output:
        S + "/outputs-validated.json"
    run:
        _, files, _ = validate(DATA)
        Path(output[0]).write_text(json.dumps({"files": [str(path) for path in files]}) + "\n")

rule package:
    input:
        archives=expand(T + "/{name}.pmtiles", name=COMPONENTS),
        resources=rules.resources.input,
        validated=rules.validate_outputs.output,
        style=str(ROOT / "styles/default.json"),
        code=[str(ROOT / "scripts/package.py"), str(ROOT / "scripts/map_style.py")],
        override=[config["ARCHIVE"]] if config.get("ARCHIVE") else []
    output:
        str(DATA / "package" / "manifest.json")
    resources:
        mem_mb=16384
    run:
        destination = Path(output[0]).parent
        if destination.is_dir():
            destination.rmdir()  # Only Snakemake's empty output parent; refuses existing package files.
        command = [sys.executable, str(ROOT / "scripts/package.py"), "--data-root", str(DATA)]
        if config.get("ARCHIVE"):
            command += ["--archive", config["ARCHIVE"]]
        tasks.run(*command)
