set shell := ["bash", "-eu", "-o", "pipefail", "-c"]
set positional-arguments

# List pipeline commands. Python dependencies are managed by uv.
default:
    @just --list

# Check installed generation tools and Python GIS bindings.
doctor:
    @uv run --locked bash scripts/doctor.sh

# Check source inputs and configuration, not generated outputs. Accepts NAME=value overrides.
check *overrides:
    @uv run --locked python scripts/pipeline.py check "$@"

[doc("""
Fetch all, dem, osm, natural-earth, coastlines or fonts through Snakemake.
Accepts --dry-run and NAME=value overrides.
""")]
download source *args:
    @uv run --locked python scripts/pipeline.py download "$@"

[doc("""
Run a workflow target and its dependencies, including downloads when needed.
Targets: build (default: four core archives/resources), maps, osm, overview,
coastlines, terrain, terrain-contours, terrain-hillshade, terrain-tiles,
resources, sprites, fonts, planetiler-image, terrain-inventory, package.
`just build package` builds all six components and the immutable package.
Accepts --dry-run and NAME=value overrides; package also accepts --archive <path>.
""")]
build target="build" *args:
    @uv run --locked python scripts/pipeline.py build "$@"

[doc("""
Delete derived outputs while preserving the package, DEMs and compressed terrain.
--include-package removes the package and incomplete staging directory.
--include-downloads additionally removes non-DEM downloads. Accepts NAME=value overrides.
""")]
clean *args:
    @uv run --locked python scripts/pipeline.py clean "$@"
